#!/usr/bin/env bash
# Refuses commits made directly on main and commits on a badly named branch.
# Installed by tool/setup.sh (git config core.hooksPath .githooks).
# Rules: docs/git-workflow.md
set -euo pipefail

readonly branch_pattern='^(feat|fix|refactor|test|docs|chore|build|ci|perf|style|revert)/[a-z0-9]+(-[a-z0-9]+)*$'

branch="$(git symbolic-ref --quiet --short HEAD || true)"

# Detached HEAD: a rebase or a bisect is replaying commits; let it through.
if [ -z "$branch" ]; then
  exit 0
fi

if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "pre-commit: direct commits on '$branch' are not allowed." >&2
  echo "Create a branch first, for example:" >&2
  echo "  git switch -c feat/f1-03-profile-repository" >&2
  echo "See docs/git-workflow.md." >&2
  exit 1
fi

if ! printf '%s' "$branch" | grep -Eq "$branch_pattern"; then
  echo "pre-commit: branch name '$branch' does not follow <type>/<slug>." >&2
  echo "Types: feat fix refactor test docs chore build ci perf style revert." >&2
  echo "Slug: lowercase words joined by '-', task id first when there is" >&2
  echo "one (feat/f1-03-profile-repository). See docs/git-workflow.md." >&2
  echo "Rename it with: git branch -m <new-name>" >&2
  exit 1
fi
