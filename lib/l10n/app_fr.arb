    "description": "Screen-reader name of the red color swatch of the player creation. Color adjective, one word. Never displayed."
  },
  "profileColorBlue": "Bleu",
  "@profileColorBlue": {
    "description": "Screen-reader name of the blue color swatch of the player creation. Color adjective, one word. Never displayed."
  },
  "profileColorPink": "Rose",
  "@profileColorPink": {
    "description": "Screen-reader name of the pink color swatch of the player creation. Color adjective, one word. Never displayed."
