    "description": "Title of the green message after a right answer (\"Well done!\"). One short line."
  },
  "quizFeedbackWrong": "Presque !",
  "@quizFeedbackWrong": {
    "description": "Title of the red message after a wrong answer (\"Almost!\"). Encouraging, never blaming. One short line."
  },
  "quizFeedbackTimeUp": "Temps écoulé !",
  "@quizFeedbackTimeUp": {
    "description": "Title of the red message when the time to answer ran out (\"Time is up!\"). One short line."
  },
  "quizLightning": "Éclair !",
  "@quizLightning": {
    "description": "Mention next to the title of the green message when the right answer came in under 3 seconds (\"Lightning!\"). One short word."
  },
  "quizContinue": "Continuer",
  "@quizContinue": {
    "description": "Button under the answer feedback that shows the next question (\"Continue\"). Infinitive verb."
  },
  "quizQuitTitle": "Quitter le quiz ?",
  "@quizQuitTitle": {
    "description": "Title of the dialog that confirms leaving a quiz (\"Leave the quiz?\")."
  },
  "quizQuitMessage": "Tes réponses comptent pour ta progression, mais cette partie ne te donnera pas de récompense.",
  "@quizQuitMessage": {
    "description": "Body of the dialog that confirms leaving a quiz: the answers given still help the child progress, but the game gives no reward. Informal \"tu\"."
  },
  "quizQuitConfirm": "Quitter",
  "@quizQuitConfirm": {
    "description": "Button of the quit dialog that leaves the quiz (\"Leave\"). Infinitive verb, one word."
  },
  "quizQuitCancel": "Continuer à jouer",
  "@quizQuitCancel": {
    "description": "Button of the quit dialog that goes back to the quiz (\"Keep playing\")."
  },
  "quizSpokenTimes": "fois",
  "@quizSpokenTimes": {
    "description": "Word read by the screen reader for the multiplication sign of a question (\"times\"). The reader joins the words in the order of the operation: number, this word, number, \"quizSpokenEquals\", then a number or \"quizSpokenBlank\", such as \"5 fois 7 égale combien\". Never displayed."
  },
  "quizSpokenEquals": "égale",
  "@quizSpokenEquals": {
    "description": "Word read by the screen reader for the equals sign of a question (\"equals\"), as in \"5 fois 7 égale combien\". Joined with the other words in the order of the operation. Never displayed."
  },
  "quizSpokenBlank": "combien",
  "@quizSpokenBlank": {
    "description": "Word read by the screen reader for the missing number at the end of a question (\"how much\"), as in \"5 fois 7 égale combien\". Joined with the other words in the order of the operation. Never displayed."
  },
  "quizProvisionalStart": "Jouer à la table de 5",
  "@quizProvisionalStart": {
    "description": "Temporary button of the home tab that starts a quiz on the table of 5, until the learning path arrives (\"Play the table of 5\")."
  },
  "quizModeFreeTraining": "Entraînement libre",
  "@quizModeFreeTraining": {
    "description": "Name of the free training mode, shown under the results title (\"Free training\")."
  },
  "resultsTitle": "Partie terminée !",
  "@resultsTitle": {
    "description": "Big title of the results screen after a quiz (\"Game over!\" in a cheerful sense, \"All done!\"). One line."
  },
  "resultsSubtitle": "{unit} · {mode}",
  "@resultsSubtitle": {
    "description": "Line under the results title: the unit and the mode of the quiz, such as \"Table de 5 · Entraînement libre\". Keep the middle dot.",
    "placeholders": {
      "unit": {
        "type": "String",
        "example": "Table de 5"
      },
      "mode": {
        "type": "String",
        "example": "Entraînement libre"
      }
    }
  },
  "resultsCorrectCount": "{correct} / {total}",
  "@resultsCorrectCount": {
    "description": "Big number of a results tile: right answers out of the scored questions (\"9 / 10\"). Keep it short, it shares a row with another tile.",
    "placeholders": {
      "correct": {
        "type": "int",
        "example": "9"
      },
      "total": {
        "type": "int",
        "example": "10"
      }
    }
  },
  "resultsCorrectLabel": "{correct, plural, one{réussie} other{réussies}}",
  "@resultsCorrectLabel": {
    "description": "Small label under the right-answer count of the results (\"right\"), agreeing in number with the count. Feminine in French because it stands for \"questions réussies\". One word.",
    "placeholders": {
      "correct": {
        "type": "int",
        "example": "9"
      }
    }
  },
  "resultsAverageTime": "{seconds} s",
  "@resultsAverageTime": {
    "description": "Big number of a results tile: average answer time in seconds with one decimal (\"2,4 s\"). Keep the unit abbreviated.",
    "placeholders": {
      "seconds": {
        "type": "double",
        "format": "decimalPatternDigits",
        "optionalParameters": {
          "decimalDigits": 1
        },
        "example": "2.4"
      }
    }
  },
  "resultsAverageTimeLabel": "en moyenne",
  "@resultsAverageTimeLabel": {
    "description": "Small label under the average answer time of the results (\"on average\")."
  },
  "resultsToReview": "À revoir",
  "@resultsToReview": {
    "description": "Heading of the results card listing the facts the child missed (\"To review\")."
  },
  "resultsNothingToReview": "Aucune erreur, bravo !",
  "@resultsNothingToReview": {
    "description": "Shown in the \"To review\" card when the child missed nothing (\"No mistake, well done!\")."
  },
  "resultsContinue": "Continuer",
  "@resultsContinue": {
    "description": "Main button of the results screen, back to the home (\"Continue\"). Infinitive verb."
  },
  "resultsReplay": "Rejouer",
  "@resultsReplay": {
    "description": "Second button of the results screen, plays the same quiz again (\"Play again\"). Infinitive verb."
  }
