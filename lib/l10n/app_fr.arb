{
  "@@locale": "fr",
  "appTitle": "Kid Matix",
  "@appTitle": {
    "description": "Provisional application name, shown as the task-switcher title. Brand name: keep as is, do not translate."
  },
  "mainNavigationLabel": "Navigation principale",
  "@mainNavigationLabel": {
    "description": "Screen-reader label of the bottom tab bar of the main shell (\"Main navigation\"). Never displayed."
  },
  "tabLearningPath": "Parcours",
  "@tabLearningPath": {
    "description": "Label of the learning path tab in the bottom tab bar, also the title of its placeholder page. Noun (\"Path\"), one short word."
  },
  "tabTraining": "S'entraîner",
  "@tabTraining": {
    "description": "Label of the free training tab in the bottom tab bar, also the title of its placeholder page. Infinitive verb (\"Practice\"), one short word."
  },
  "tabChallenges": "Défis",
  "@tabChallenges": {
    "description": "Label of the challenges tab in the bottom tab bar, also the title of its placeholder page. Plural noun (\"Challenges\"), one short word."
  },
  "tabProfile": "Profil",
  "@tabProfile": {
    "description": "Label of the profile tab in the bottom tab bar, also the title of its placeholder page. Noun (\"Profile\"), one short word."
  },
  "comingSoonMessage": "Bientôt disponible",
  "@comingSoonMessage": {
    "description": "Centered message on the placeholder page of a tab whose feature is not built yet, and on the temporary home tab above its quiz button until the learning path arrives (\"Coming soon\"). One line."
  },
  "commonRetry": "Réessayer",
  "@commonRetry": {
    "description": "Button that runs a failed action again (load the players, save the profile). Infinitive verb, one line."
  },
  "commonBack": "Retour",
  "@commonBack": {
    "description": "Tooltip and screen-reader label of the back arrow at the top left of a screen, and label of the button that leaves the quiz screen when the quiz cannot start (\"Back\"). One short word."
  },
  "errorStorage": "Oups, on n'a pas pu lire ou enregistrer tes données.",
  "@errorStorage": {
    "description": "Error shown to a child on the \"Qui joue ?\" screen, under the button of the player creation, and on the quiz and results screens when the local database fails. Friendly tone, informal \"tu\", no technical words."
  },
  "errorNotFound": "Ce joueur n'existe plus.",
  "@errorNotFound": {
    "description": "Error shown on the \"Qui joue ?\" screen or the player creation when the chosen player was deleted in the meantime (\"This player no longer exists\")."
  },
  "errorUnknown": "Oups, quelque chose s'est mal passé.",
  "@errorUnknown": {
    "description": "Generic error shown to a child on the \"Qui joue ?\" screen, the player creation, and the quiz and results screens when nothing more precise is known. Friendly tone."
  },
  "whoIsPlayingTitle": "Qui joue ?",
  "@whoIsPlayingTitle": {
    "description": "Title of the player selection screen shown at launch (\"Who is playing?\"). Big title, one line."
  },
  "whoIsPlayingSubtitle": "Choisis ton joueur pour commencer.",
  "@whoIsPlayingSubtitle": {
    "description": "Line under the title of the player selection screen; speaks to the child with \"tu\"."
  },
  "profileLevel": "Niveau {level}",
  "@profileLevel": {
    "description": "Player level under the nickname on a player card of the \"Qui joue ?\" screen (\"Level 4\"). Short, one line in half the screen width.",
    "placeholders": {
      "level": {
        "type": "int",
        "example": "4"
      }
    }
  },
  "newPlayerButton": "Nouveau joueur",
  "@newPlayerButton": {
    "description": "Label of the dashed card that opens the creation of a player (\"New player\"). Fits on one line in half the screen width."
  },
  "profileLimitHint": "{maxProfiles, plural, one{Jusqu'à {maxProfiles} joueur sur ce téléphone.} other{Jusqu'à {maxProfiles} joueurs sur ce téléphone.}}",
  "@profileLimitHint": {
    "description": "Footer of the \"Qui joue ?\" screen: how many players the phone can hold (\"Up to 10 players on this phone\"). One or two lines.",
    "placeholders": {
      "maxProfiles": {
        "type": "int",
        "example": "10"
      }
    }
  },
  "profileLimitReached": "{maxProfiles, plural, one{Il y a déjà {maxProfiles} joueur sur ce téléphone.} other{Il y a déjà {maxProfiles} joueurs sur ce téléphone.}}",
  "@profileLimitReached": {
    "description": "Error under the button of the player creation when the phone already holds the maximum number of players (\"There are already 10 players on this phone\").",
    "placeholders": {
      "maxProfiles": {
        "type": "int",
        "example": "10"
      }
    }
  },
  "profileCreationTitle": "Nouveau joueur",
  "@profileCreationTitle": {
    "description": "Title at the top of the screen that creates a player (\"New player\"). Same French words as newPlayerButton but this one is a screen title. One line."
  },
  "nicknameLabel": "Ton pseudo",
  "@nicknameLabel": {
    "description": "Label above the nickname field of the player creation (\"Your nickname\"), informal \"tu\". One line."
  },
  "nicknameHint": "Écris ton pseudo",
  "@nicknameHint": {
    "description": "Placeholder inside the empty nickname field of the player creation (\"Type your nickname\"). Imperative, informal \"tu\", one line."
  },
  "nicknameRulesHint": "{maxLength, plural, one{{minLength} à {maxLength} lettre ou chiffre} other{{minLength} à {maxLength} lettres ou chiffres}}",
  "@nicknameRulesHint": {
    "description": "Hint under the nickname field of the player creation: allowed length and characters (\"2 to 12 letters or digits\"). One line.",
    "placeholders": {
      "minLength": {
        "type": "int",
        "example": "2"
      },
      "maxLength": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "nicknameTooShort": "{minLength, plural, one{Il faut au moins {minLength} lettre ou chiffre.} other{Il faut au moins {minLength} lettres ou chiffres.}}",
  "@nicknameTooShort": {
    "description": "Error under the nickname field of the player creation when the nickname is too short (\"At least 2 letters or digits are needed\"). Speaks to a child, no blame.",
    "placeholders": {
      "minLength": {
        "type": "int",
        "example": "2"
      }
    }
  },
  "nicknameTooLong": "{maxLength, plural, one{Pas plus de {maxLength} lettre ou chiffre.} other{Pas plus de {maxLength} lettres ou chiffres.}}",
  "@nicknameTooLong": {
    "description": "Error under the nickname field of the player creation when the nickname is too long (\"No more than 12 letters or digits\"). Speaks to a child, no blame.",
    "placeholders": {
      "maxLength": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "nicknameInvalidCharacters": "Seulement des lettres, des chiffres et des espaces.",
  "@nicknameInvalidCharacters": {
    "description": "Error under the nickname field of the player creation when it contains another character (punctuation, emoji) (\"Only letters, digits and spaces\")."
  },
  "nicknameTaken": "Ce nom est déjà pris sur ce téléphone.",
  "@nicknameTaken": {
    "description": "Error under the nickname field when another player of the phone already uses this nickname, ignoring case and accents. Wording from the specifications."
  },
  "avatarPickerLabel": "Choisis ton avatar",
  "@avatarPickerLabel": {
    "description": "Heading of the grid of 12 characters in the player creation (\"Choose your avatar\")."
  },
  "avatarOptionLabel": "Avatar {number}",
