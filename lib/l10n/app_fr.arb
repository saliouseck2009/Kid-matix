    "description": "Screen-reader label of one character of the avatar grid of the player creation (\"Avatar 3\"). Never displayed.",
    "placeholders": {
      "number": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "colorPickerLabel": "Ta couleur",
  "@colorPickerLabel": {
    "description": "Heading of the row of color swatches in the player creation (\"Your color\"), informal \"tu\". One line."
  },
